    function display_on() {
      if (lookup !== true) {
        for (let i = 0; i < fields_form.length; i++) {
          if (i < (displayfield+1)) {
            fields_arr[i] = fields_lookup[i];
          };

          if (i > displayfield) {
            document.getElementById(fields_form[i]).style.display = 'none';
          };
        };

        document.getElementById('epp10').style.display = 'block';

        if (no_lookup === true) {
          document.getElementById('Submit_contact').style.display = 'block';
          document.getElementById('Submit').style.display = 'none';
        };
      };
      document.getElementById('body_lookup').style.display = 'block';
    };

    function redirect_to_assets() {
      var url = window.location.href;
      var docUrl = document.getElementById('doc_Url').value;

      if ((url.indexOf('?' + 'success=true') !== -1) || (url.indexOf('&' + 'success=true') !== -1)) {
        document.getElementById('body_lookup').style.display = 'block';
        document.getElementById('form_body').style.display = 'none';
        document.getElementById('ty_div').style.display = 'block';

        if (docUrl !== '') {
          setTimeout(function () {
            window.top.location = docUrl;
          }, 1500);
        };
      };
    };

   document.addEventListener("DOMContentLoaded", function () {
      fSetUData();
      redirect_to_assets();
	  TPCLoaded();
      setTimeout('display_on()', 5000);
      destination();
    });

    function validateEmail(email) {
      var re =
        /^(([^<>()[\]\\.,;:\s@\"]+(\.[^<>()[\]\\.,;:\s@\"]+)*)|(\".+\"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
      return re.test(email);
    };

    function validate_form() {
        if( typeof _satellite !== 'undefined') {
            document.getElementById("field14").value = _satellite.getVisitorId().getMarketingCloudVisitorID();
        }
      //document.getElementById("field14").value = _satellite.getVisitorId().getMarketingCloudVisitorID();
      
      
      var j = '';
      var check = true;
      var index = fields_arr.indexOf(optinLookupField);
      
      // Put default  form error class for lblFormValidationCheck
      document.getElementById('lblFormValidationCheck').classList.add('form_error');

      if (index > -1) {
        fields_arr.splice(index, 1);
      };

      for (let k = 0; k < fields_arr.length; k++) {
        if (document.getElementById('field0').value === '') {
          check = false;

          document.getElementById('span0').innerHTML = 'Required field';
          document.getElementById('span0').style.display = 'block';
          document.getElementById('lbl0').classList.add('form_error');
          document.getElementById('field0').style.borderColor = 'red';
        } else {
          if (validateEmail(document.getElementById('field0').value) === true) {
            document.getElementById('span0').style.display = 'none';
            document.getElementById('lbl0').classList.remove('form_error');
            document.getElementById('field0').style.borderColor = '';
          } else {
            check = false;

            document.getElementById('span0').innerHTML = 'Please enter valid Email address';
            document.getElementById('span0').style.display = 'block';
            document.getElementById('lbl0').classList.add('form_error');
            document.getElementById('field0').style.borderColor = 'red';
          };
        };

        if (fields_arr.length !== 0) {
          fields_arr = fields_arr.filter(function (element) {
            return element !== undefined;
          });

          if (fields_arr[k] !== undefined) {
            j = fields_lookup.indexOf(fields_arr[k]);
            var str = fields_id_form[j];
            var number = str.replace("field", "");

            if (document.getElementById(fields_id_form[j]).value === '') {
              check = false;

              document.getElementById('span' + number).style.display = 'block';
              document.getElementById('lbl' + number).classList.add('form_error');
              document.getElementById(fields_id_form[j]).style.borderColor = 'red';
            } else {
              document.getElementById('span' + number).style.display = 'none';
              document.getElementById('lbl' + number).classList.remove('form_error');
              document.getElementById(fields_id_form[j]).style.borderColor = '';
            };
          };
        };
      };

      var r = document.getElementsByName("Sales_Contact")
	  var c = 0

	  for(var i=0; i < r.length; i++){
		if(r[i].checked) {
			c = 1; 
	  		};
      }
      if(c==0)
		{
		check=false;
        document.getElementById("lblSalesContact").style.color = 'red';
        document.getElementById("span11").style.display = 'block';
        document.getElementById('lblFormValidationCheck').classList.add('form_error');
		}
      else{        
        document.getElementById("lblSalesContact").style.color = '';
        document.getElementById("span11").style.display = 'none';
        document.getElementById('lblFormValidationCheck').classList.remove('form_error');
      }
      
      destination();

      if (check !== false) {
        document.getElementById('field0').readOnly = false;
      };
      
      if ( check ) 
      {
        // Remove form error class for lblFormValidationCheck when for above  validation check pass 
      	document.getElementById('lblFormValidationCheck').classList.remove('form_error');
      }

      return check;
    };

    var no_lookup = '';

    function display_div() {
      var webLeadId = Math.uuid()+"--"+Math.uuid(6,16);
            document.getElementsByName("webLeadId")[0].value = webLeadId;
      
      
      if (document.getElementById('field0').value !== '') {
        if (validateEmail(document.getElementById('field0').value) === true) {
          if (lookup !== true) {
            no_lookup = true;
            fields_arr.length = 0;

            document.getElementById('Submit').style.display = 'none';
            document.getElementById('outer_spn').style.display = 'none';

            _elqQ.push(['elqDataLookup', escape(LookupIdContact), '<' + ContactUniqueField + '>' + document
              .getElementById('field0').value + '</' + ContactUniqueField + '>'
            ]);

            setTimeout(function () {
              if (lookup !== true) {
                display_on();
              };
              document.getElementById('main_body').style.display = 'block';
            }, 4000);
          } else {
            document.getElementById('Continue').style.display = 'none';
            document.getElementById('Submit_contact').style.display = 'block';
            document.getElementById('main_body').style.display = 'block';
            document.getElementById('outer_spn').style.display = 'block';
          };
          document.getElementById('span0').style.display = 'none';
          document.getElementById('epp10').style.display = 'none';
          document.getElementById('field0').readOnly = true;
          document.getElementById('lbl0').classList.remove('form_error');
          document.getElementById('field0').style.borderColor = '';
        } else {
          document.getElementById('span0').innerHTML = 'Please enter valid Email address';
          document.getElementById('span0').style.display = 'block';
          document.getElementById('lbl0').classList.add('form_error');
          document.getElementById('field0').style.borderColor = 'red';
        };
      } else {
        document.getElementById('span0').innerHTML = 'Required field';
        document.getElementById('span0').style.display = 'block';
        document.getElementById('lbl0').classList.add('form_error');
        document.getElementById('field0').style.borderColor = 'red';
      };

      if (no_lookup === true) {
        document.getElementById('outer_spn').style.display = 'none';
      };
    };

    function eraseCookieFromAllPaths(name) {
      document.cookie = 'ELOQUA=Blank; expires=Thu, 01 Jan 1970 00:00:01 GMT; path=/';

      var cookies = document.cookie.split(';');
    };

    function clear_email() {
      lookup = false;
	  //console.log("Line728, displayfield:"+displayfield);
      document.getElementById('Continue').id = 'Submit';
      document.getElementById('main_body').style.display = 'none';
      document.getElementById('field0').readOnly = false;

      for (let i = 0; i < fields_lookup.length; i++) {
        document.getElementById(fields_id_form[i]).value = '';

        if (i < (displayfield+1)) {
          fields_arr[i] = fields_lookup[i];

          document.getElementById(fields_form[i]).style.display = 'block';
        };

        if (i > displayfield) {
          document.getElementById(fields_form[i]).style.display = 'none';
        };
      };

      eraseCookieFromAllPaths('ELOQUA');

      document.getElementById('Submit_contact').style.display = 'none';
      document.getElementById('Submit').style.display = 'block';
      //document.getElementById('field10').checked = false;
      $("#field10").attr("checked", false);
      document.getElementById('field10').value = 'True';
      document.getElementById('body_lookup').style.display = 'block';
      document.getElementById('outer_spn').style.display = 'none';
    };

