    'C_PP___Job_Level1', 'C_PP___Job_Responsibility1','C_sourceOfInterest_supportTest1'];
    var fields_form = ['epp0', 'epp1', 'epp2', 'epp3', 'epp4', 'epp5', 'epp6', 'epp7', 'epp8', 'epp9','epp10'];
    var fields_id_form = ['field0', 'field1', 'field2', 'field3', 'field4', 'field5','field6', 'field7','field8','field9', 'field10'];
    
    function destination() {
      var url = window.location.href;

      if ((url.indexOf('?' + 'success=true') !== -1) || (url.indexOf('&' + 'success=true') !== -1)) {
        document.getElementById('r_url').value = url;
      } else {
        if (url.indexOf('?') !== -1) {
          url = url + '&success=true';
          document.getElementById('r_url').value = url;
        } else {
          url = url + '?success=true';
          document.getElementById('r_url').value = url;
        };
      };
    }
    function SetElqContent() 
    {
      
      
      //console.log("TPC_CHANGE:1-SetElqContent, this.GetElqContentPersonalizationValue=|"+this.GetElqContentPersonalizationValue+"|");
      //console.log("TPC_CHANGE:2-SetElqContent, GetElqContentPersonalizationValue(V_ElqEmailAddress)=|"+GetElqContentPersonalizationValue(VisitorUniqueField)+"|");
      bFoundTPC = true;
      //console.log("TPC_CHANGE:3-SetElqContent, bFoundTPC=|"+bFoundTPC+"|");
      
      
      if (this.GetElqContentPersonalizationValue && GetElqContentPersonalizationValue(VisitorUniqueField)) {
        _elqQ.push(['elqDataLookup', escape(LookupIdContact), '<' + ContactUniqueField + '>' +
          GetElqContentPersonalizationValue(VisitorUniqueField) + '</' + ContactUniqueField + '>'
        ]);
        //console.log('TPC_CHANGE:4-Visitor Lookup Found');
        
      } else if (this.GetElqContentPersonalizationValue && GetElqContentPersonalizationValue(ContactUniqueField)) 
      {
        //console.log('TPC_CHANGE:5-Contact Lookup Found');
        lookup = true;

        //document.getElementById('Submit').id = 'Continue';
        if(document.getElementById('Submit')!=null){
          	//console.log("Submit Found");
          	document.getElementById('Submit').id = 'Continue';
        }
        document.getElementById('field0').readOnly = true;

        k = 0;
        fields_arr.length = 0;

        for (let i = 0; i < fields_lookup.length; i++) {
          if (GetElqContentPersonalizationValue(fields_lookup[i]) !== '') {
            if (no_lookup !== true) {
              document.getElementById('pop_email').innerHTML = GetElqContentPersonalizationValue(fields_lookup[0]);
              document.getElementById('outer_spn').style.display = 'block';
            };

            if (i !== 0) {
              document.getElementById(fields_form[i]).style.display = 'none';
            };


            document.getElementById(fields_id_form[i]).value = GetElqContentPersonalizationValue(fields_lookup[i]);

          } else {
            document.getElementById('Submit_contact').style.display = 'block';

            fields_arr[k] = fields_lookup[i];
            //console.log("Line153, displayfield:"+displayfield);

            if (fields_arr.length < (displayfield+1)) {
                document.getElementById(fields_form[i]).style.display = 'block';
            } else {
              document.getElementById(fields_form[i]).style.display = 'none';
            };

            k++;
          };
        };

        if (fields_arr.length === 0) {
          if (no_lookup === true) {
            //added Sales Contact Question, so user need to answer before submitting
            //document.getElementById('formElement28').style.display = 'none';
            //document.getElementById('Submit_contact').style.display = 'none';
            destination();
            //document.getElementById('Submit_contact').click();
            //document.getElementById('form5684').submit();  changed to button click to match AEM cookie logic
