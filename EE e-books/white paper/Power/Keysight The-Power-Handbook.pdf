            document.getElementById('Submit_contact').style.display = 'block';
            document.getElementById('Continue').style.display = 'none';
            document.getElementById('span0').style.display = 'none';
          };
        };

        document.getElementById('body_lookup').style.display = 'block';

        display_div();

        if ((GetElqContentPersonalizationValue('C_Email_Optin1') === 'True' || GetElqContentPersonalizationValue(
          'C_Email_Optin1') === 'Yes') && (GetElqContentPersonalizationValue('C_Privacy_Agreement_Opt_In1') === 'True' || GetElqContentPersonalizationValue('C_Privacy_Agreement_Opt_In1') === 'Yes')) {
          document.getElementById('field10').checked = true;
        } else {
          document.getElementById('epp10').style.display = 'block';
        };

        var filtered = fields_arr.filter(function (el) {
